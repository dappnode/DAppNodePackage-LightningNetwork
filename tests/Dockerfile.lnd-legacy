# Test-only: create an unfunded wallet using the package's previous LND release.
FROM node:22.23.4-alpine3.24
ARG LND_VERSION=v0.14.1-beta
ARG LND_SHA256=7034e4aea3f404a9bbb1d157653741eb0e020c3d3272f854d3e2cefa0070f24a
RUN apk add --no-cache ca-certificates curl \
 && curl --fail --location "https://github.com/lightningnetwork/lnd/releases/download/${LND_VERSION}/lnd-linux-amd64-${LND_VERSION}.tar.gz" -o /tmp/lnd.tar.gz \
 && echo "${LND_SHA256}  /tmp/lnd.tar.gz" | sha256sum -c - \
 && tar --strip-components=1 -xzf /tmp/lnd.tar.gz -C /usr/local/bin \
 && rm /tmp/lnd.tar.gz
ENTRYPOINT ["lnd"]
