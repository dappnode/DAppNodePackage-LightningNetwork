FROM debian:bookworm-slim
ARG BITCOIN_VERSION=31.1
ARG BITCOIN_SHA256=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 \
 && curl --fail --location "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/bitcoin-${BITCOIN_VERSION}-x86_64-linux-gnu.tar.gz" -o /tmp/bitcoin.tar.gz \
 && echo "${BITCOIN_SHA256}  /tmp/bitcoin.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/bitcoin.tar.gz --strip-components=2 -C /usr/local/bin "bitcoin-${BITCOIN_VERSION}/bin/bitcoind" "bitcoin-${BITCOIN_VERSION}/bin/bitcoin-cli" \
 && rm /tmp/bitcoin.tar.gz && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["bitcoind"]
