diff --git a/server/utils/lndTls.ts b/server/utils/lndTls.ts
new file mode 100644
index 0000000..ed36818
--- /dev/null
+++ b/server/utils/lndTls.ts
@@ -0,0 +1,84 @@
+import { closeSync, fstatSync, openSync, readFileSync } from 'node:fs';
+import { Agent } from 'node:https';
+import { isAbsolute } from 'node:path';
+import { X509Certificate } from 'node:crypto';
+
+export interface LndTlsPolicy {
+  origin: string;
+  certPath?: string;
+  allowEphemeral?: boolean;
+}
+
+const tlsError = (code: string, message: string): Error & { code: string } => Object.assign(new Error(message), { code });
+
+// Keep paths and the credentialed origin in server-owned node configuration. Carry plain
+// metadata, not Agent instances, because RTL clones selected nodes into sessions.
+export const lndTlsOptions = (node) => {
+  if ((node?.lnImplementation || 'LND').toUpperCase() !== 'LND') { return {}; }
+  return {
+    lndTls: {
+      origin: node?.settings?.lnServerUrl,
+      certPath: node?.authentication?.tlsCertPath,
+      allowEphemeral: node?.authentication?.tlsAllowEphemeral === true
+    } as LndTlsPolicy
+  };
+};
+
+const readCertificate = (path: string): Buffer | undefined => {
+  let fd: number;
+  try {
+    fd = openSync(path, 'r');
+  } catch (err) {
+    if (err.code === 'ENOENT') { return undefined; }
+    throw tlsError('LND_TLS_CERT_UNAVAILABLE', 'Cannot read the configured LND TLS certificate.');
+  }
+  try {
+    const stat = fstatSync(fd);
+    if (!stat.isFile() || stat.size === 0 || stat.size > 65536) { throw new Error('Invalid certificate file'); }
+    const data = readFileSync(fd);
+    const text = data.toString('utf8');
+    const certs = text.match(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g);
+    if (!certs?.length || /PRIVATE KEY/.test(text)) { throw new Error('Public certificates only'); }
+    for (const pem of certs) { new X509Certificate(pem); }
+    return data;
+  } catch {
+    throw tlsError('LND_TLS_CERT_INVALID', 'The configured LND TLS certificate is invalid or not ready.');
+  } finally {
+    closeSync(fd);
+  }
+};
+
+export const createLndTlsAgent = (policy: LndTlsPolicy, url: string, baseUrl?: string): Agent => {
+  let expected: URL;
+  let target: URL;
+  try {
+    expected = new URL(policy.origin);
+    target = baseUrl ? new URL(url, baseUrl) : new URL(url);
+  } catch {
+    throw tlsError('LND_TLS_ORIGIN', 'Invalid LND HTTPS endpoint configuration.');
+  }
+  if (expected.protocol !== 'https:' || target.protocol !== 'https:' || target.origin !== expected.origin ||
+    expected.username || expected.password || expected.search || expected.hash || target.username || target.password) {
+    throw tlsError('LND_TLS_ORIGIN', 'LND requests require HTTPS to the configured node origin.');
+  }
+
+  let ca: Buffer[] | undefined;
+  if (policy.certPath !== undefined) {
+    if (typeof policy.certPath !== 'string' || !isAbsolute(policy.certPath)) {
+      throw tlsError('LND_TLS_CERT_INVALID', 'LND tlsCertPath must be an absolute public certificate path.');
+    }
+    // A missing permanent file is legitimate while encrypted-key LND uses its local,
+    // temporary pre-unlock certificate. Never learn trust from a network handshake.
+    ca = [readCertificate(policy.certPath)];
+    if (policy.allowEphemeral) { ca.push(readCertificate(policy.certPath + '.tmp')); }
+    ca = ca.filter((cert) => cert !== undefined);
+    if (ca.length === 0) { throw tlsError('LND_TLS_CERT_UNAVAILABLE', 'LND TLS certificate is not ready; wait for LND or check its certificate configuration.'); }
+  } else if (policy.allowEphemeral) {
+    throw tlsError('LND_TLS_CERT_INVALID', 'Temporary LND certificate trust requires tlsCertPath.');
+  }
+
+  // A fresh agent reads current local trust on each request. No cross-request connection
+  // or TLS-session reuse can retain an old certificate across LND renewal/unlock.
+  // Node's built-in hostname/expiry checks remain enabled.
+  return new Agent({ ca, rejectUnauthorized: true, keepAlive: false, maxCachedSessions: 0 });
+};
