diff --git a/test/backend/lnd-tls.test.mjs b/test/backend/lnd-tls.test.mjs
new file mode 100644
index 0000000..5d4ec0f
--- /dev/null
+++ b/test/backend/lnd-tls.test.mjs
@@ -0,0 +1,167 @@
+import assert from 'node:assert/strict';
+import { chmodSync, copyFileSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { createServer } from 'node:https';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test, { after } from 'node:test';
+import { certificate } from '../helpers/lnd-https.mjs';
+import request from '../../backend/utils/request.js';
+import { lndTlsOptions } from '../../backend/utils/lndTls.js';
+import { Common } from '../../backend/utils/common.js';
+import { LNDWSClient } from '../../backend/controllers/lnd/webSocketClient.js';
+import { WSServer } from '../../backend/utils/webSocketServer.js';
+
+const root = mkdtempSync(join(tmpdir(), 'rtl-tls-test-'));
+after(() => { clearInterval(WSServer.pingInterval); rmSync(root, { recursive: true, force: true }); });
+const trusted = certificate();
+const impostor = certificate();
+const credential = 'synthetic-macaroon-do-not-log';
+const listen = async (pair = trusted, handler) => {
+  const seen = [];
+  const server = createServer({ key: pair.key, cert: pair.cert }, (req, res) => {
+    seen.push({ url: req.url, credential: req.headers['grpc-metadata-macaroon'] });
+    req.resume();
+    if (handler) { handler(req, res); } else { res.setHeader('Content-Type', 'application/json'); res.end('{"ok":true}'); }
+  });
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  return { server, seen, url: `https://127.0.0.1:${server.address().port}`, close: () => { server.closeAllConnections(); return new Promise((resolve) => server.close(resolve)); } };
+};
+const options = (url, certPath = trusted.certPath, extra = {}) => ({
+  url, json: true, timeout: 2000, rejectUnauthorized: false,
+  headers: { 'Grpc-Metadata-macaroon': credential },
+  lndTls: { origin: url, certPath, ...extra }
+});
+const rejects = (promise, code) => assert.rejects(promise, (error) => {
+  assert.equal(error.name, 'RequestError');
+  if (code) { assert.match(error.error.code, code); }
+  assert.ok(!JSON.stringify(error).includes(credential));
+  assert.ok(!JSON.stringify(error).includes('PRIVATE KEY'));
+  return true;
+});
+
+test('verified local certificate works even with legacy insecure options; errors omit credentials', async () => {
+  const lnd = await listen();
+  try {
+    assert.deepEqual(await request(options(lnd.url)), { ok: true });
+    assert.equal(lnd.seen[0].credential, credential);
+    await rejects(request(options(lnd.url, impostor.certPath)));
+    assert.equal(lnd.seen.length, 1, 'untrusted handshake sent no HTTP request');
+  } finally { await lnd.close(); }
+});
+
+for (const [name, pair, code] of [
+  ['untrusted', impostor, /SELF_SIGNED|VERIFY_LEAF/],
+  ['wrong hostname', certificate({ san: 'DNS:another-node.invalid' }), /ALTNAME/],
+  ['expired', certificate({ expired: true }), /CERT_HAS_EXPIRED/]
+]) {
+  test(`${name} certificate is rejected before any macaroon is delivered`, async () => {
+    const lnd = await listen(pair);
+    try {
+      await rejects(request(options(lnd.url, name === 'untrusted' ? trusted.certPath : pair.certPath)), code);
+      assert.deepEqual(lnd.seen, []);
+    } finally { await lnd.close(); }
+  });
+}
+
+test('missing, malformed, unreadable and private-key trust files fail safely and recover', async () => {
+  const lnd = await listen();
+  const path = join(root, 'changing.cert');
+  try {
+    await rejects(request(options(lnd.url, path)), /LND_TLS_CERT_UNAVAILABLE/);
+    for (const invalid of ['', 'not a certificate', trusted.key, Buffer.concat([trusted.cert, trusted.key])]) {
+      writeFileSync(path, invalid);
+      await rejects(request(options(lnd.url, path)), /LND_TLS_CERT_INVALID/);
+    }
+    copyFileSync(trusted.certPath, path); chmodSync(path, 0);
+    await rejects(request(options(lnd.url, path)), /LND_TLS_CERT_UNAVAILABLE/);
+    chmodSync(path, 0o600);
+    assert.deepEqual(await request(options(lnd.url, path)), { ok: true });
+    assert.equal(lnd.seen.length, 1);
+  } finally { chmodSync(path, 0o600); await lnd.close(); }
+});
+
+test('rejects HTTP, mismatched origins, userinfo and relative certificate paths without connecting', async () => {
+  const lnd = await listen();
+  try {
+    for (const target of [lnd.url.replace('https:', 'http:'), lnd.url.replace('127.0.0.1', 'localhost'), lnd.url.replace('https://', 'https://user:password@'), 'invalid']) {
+      const opts = options(lnd.url); opts.url = target;
+      await rejects(request(opts), /LND_TLS_ORIGIN/);
+    }
+    await rejects(request(options(lnd.url, './tls.cert')), /LND_TLS_CERT_INVALID/);
+    const noPath = options(lnd.url); delete noPath.lndTls.certPath; noPath.lndTls.allowEphemeral = true;
+    await rejects(request(noPath), /LND_TLS_CERT_INVALID/);
+    assert.deepEqual(lnd.seen, []);
+  } finally { await lnd.close(); }
+});
+
+test('credentialed redirects are rejected and a mutating request is never replayed', async () => {
+  const receiver = await listen();
+  const sender = await listen(trusted, (_req, res) => { res.writeHead(307, { Location: receiver.url }); res.end(); });
+  try {
+    await assert.rejects(request.post({ ...options(sender.url), body: { amount: 1 } }), (e) => e.statusCode === 307);
+    assert.equal(sender.seen.length, 1);
+    assert.deepEqual(receiver.seen, []);
+  } finally { await sender.close(); await receiver.close(); }
+});
+
+test('renewal reloads local trust on every request, including ephemeral-to-permanent transition', async () => {
+  const lnd = await listen();
+  const path = join(root, 'lifecycle.cert');
+  try {
+    copyFileSync(trusted.certPath, path + '.tmp');
+    const opts = options(lnd.url, path, { allowEphemeral: true });
+    assert.deepEqual(await request(opts), { ok: true });
+    copyFileSync(impostor.certPath, path);
+    assert.deepEqual(await request(opts), { ok: true }, 'temporary certificate remains trusted during transition');
+    lnd.server.setSecureContext({ key: impostor.key, cert: impostor.cert });
+    assert.deepEqual(await request(opts), { ok: true }, 'new permanent certificate is trusted');
+    rmSync(path + '.tmp');
+    assert.deepEqual(await request(opts), { ok: true });
+    lnd.server.setSecureContext({ key: trusted.key, cert: trusted.cert });
+    await rejects(request(opts));
+    copyFileSync(trusted.certPath, path);
+    assert.deepEqual(await request(opts), { ok: true }, 'renewal needs no RTL restart');
+    assert.equal(lnd.seen.length, 5);
+  } finally { await lnd.close(); }
+});
+
+test('generic HTTPS uses public PKI and ignores insecure legacy options', async () => {
+  const lnd = await listen();
+  try {
+    const opts = options(lnd.url); delete opts.lndTls;
+    await rejects(request(opts));
+    assert.deepEqual(lnd.seen, []);
+  } finally { await lnd.close(); }
+});
+
+test('background backups and invoice/payment subscriptions reject an impostor and preserve backups', async () => {
+  const lnd = await listen(impostor);
+  const backup = join(root, 'channel-all.bak');
+  writeFileSync(backup, 'existing backup');
+  writeFileSync(join(root, 'admin.macaroon'), credential);
+  const node = { index: 999, lnNode: 'synthetic', lnImplementation: 'LND',
+    authentication: { tlsCertPath: trusted.certPath, macaroonPath: root },
+    settings: { lnServerUrl: lnd.url, channelBackupPath: root, logLevel: 'ERROR' } };
+  const logs = [];
+  const oldLog = Common.logger.log;
+  const oldSend = WSServer.sendErrorToAllLNClients;
+  Common.logger.log = (entry) => logs.push(entry);
+  WSServer.sendErrorToAllLNClients = (entry) => logs.push(entry);
+  try {
+    Common.getAllNodeAllChannelBackup(node);
+    const opts = LNDWSClient.setOptionsForSelNode(node);
+    assert.deepEqual(opts.lndTls, lndTlsOptions(node).lndTls);
+    LNDWSClient.subscribeToInvoice(opts, node, 'synthetic-invoice');
+    LNDWSClient.subscribeToPayment(opts, node, 'synthetic-payment');
+    const pending = await LNDWSClient.fetchUnpaidInvoices(node);
+    assert.ok(pending.error);
+    for (let n = 0; n < 100 && logs.filter((e) => typeof e === 'string' || e.error).length < 4; n++) {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+    assert.deepEqual(lnd.seen, []);
+    assert.equal(readFileSync(backup, 'utf8'), 'existing backup');
+    assert.ok(logs.length >= 4);
+    assert.ok(!JSON.stringify(logs).includes(Buffer.from(credential).toString('hex')));
+    assert.ok(!JSON.stringify(logs).includes(credential));
+  } finally { Common.logger.log = oldLog; WSServer.sendErrorToAllLNClients = oldSend; await lnd.close(); }
+});
