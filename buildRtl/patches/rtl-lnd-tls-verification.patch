diff --git a/test/helpers/lnd-https.mjs b/test/helpers/lnd-https.mjs
new file mode 100644
index 0000000..2291824
--- /dev/null
+++ b/test/helpers/lnd-https.mjs
@@ -0,0 +1,43 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { createServer as httpsServer } from 'node:https';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const root = mkdtempSync(join(tmpdir(), 'rtl-tls-fixtures-'));
+let next = 0;
+process.on('exit', () => rmSync(root, { recursive: true, force: true }));
+
+export function certificate({ san = 'DNS:localhost,IP:127.0.0.1,IP:::1', expired = false } = {}) {
+  const prefix = join(root, String(next++));
+  const keyPath = prefix + '.key';
+  const certPath = prefix + '.crt';
+  const base = ['req', '-new', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:P-256', '-nodes', '-keyout', keyPath, '-subj', '/CN=RTL synthetic TLS fixture'];
+  if (expired) {
+    execFileSync('openssl', [...base, '-out', prefix + '.csr'], { stdio: 'ignore' });
+    writeFileSync(prefix + '.index', '');
+    writeFileSync(prefix + '.serial', '01\n');
+    writeFileSync(prefix + '.cnf', `[ca]
+ default_ca = fixture
+[fixture]
+ database = ${prefix}.index
+ serial = ${prefix}.serial
+ new_certs_dir = ${root}
+ default_md = sha256
+ policy = names
+ x509_extensions = extensions
+[names]
+ commonName = supplied
+[extensions]
+ subjectAltName = ${san}
+`);
+    execFileSync('openssl', ['ca', '-batch', '-selfsign', '-config', prefix + '.cnf', '-in', prefix + '.csr', '-keyfile', keyPath, '-startdate', '20000101000000Z', '-enddate', '20010101000000Z', '-out', certPath, '-notext'], { stdio: 'ignore' });
+  } else {
+    execFileSync('openssl', [...base, '-x509', '-days', '2', '-addext', 'subjectAltName=' + san, '-out', certPath], { stdio: 'ignore' });
+  }
+  return { keyPath, certPath, key: readFileSync(keyPath), cert: readFileSync(certPath) };
+}
+
+const pair = certificate();
+export const tlsCertPath = pair.certPath;
+export const createServer = (handler) => httpsServer({ key: pair.key, cert: pair.cert }, handler);
